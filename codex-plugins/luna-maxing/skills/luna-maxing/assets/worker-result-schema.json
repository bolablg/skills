{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "status": { "type": "string", "enum": ["completed", "blocked", "failed"] },
    "summary": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        },
        "required": ["claim", "source", "confidence"]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["path", "summary"]
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": { "type": "string" },
          "result": { "type": "string", "enum": ["passed", "failed", "not-run"] },
          "details": { "type": "string" }
        },
        "required": ["check", "result", "details"]
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "follow_ups": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "task_id",
    "status",
    "summary",
    "evidence",
    "changes",
    "validation",
    "risks",
    "follow_ups"
  ]
}
